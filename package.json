{
  "name": "@luently/root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run typecheck && vite build",
    "typecheck": "pnpm run typecheck:nsx",
    "preview": "vite preview",
    "test": "vitest --run --reporter verbose --exclude '**/e2e/**'",
    "i:demos": "pnpm --filter @luently/demos install",
    "i:luent-site": "pnpm --filter @luently/luent-site install",
    "i:luent": "pnpm --filter luent install",
    "i:flask": "pnpm --filter @luently/flask install",
    "i:quarky": "pnpm --filter @luently/quarky install",
    "i:tree-squirl": "pnpm --filter @luently/tree-squirl install",
    "i:noriscript": "pnpm --filter @luently/noriscript install",
    "i:noriscript-site": "pnpm --filter @luently/noriscript-site install",
    "i:utils": "pnpm --filter @luently/utils install",
    "i:e2e": "pnpm --filter @luently/e2e install",
    "test:demos": "pnpm exec playwright test --config=e2e/playwright.config.ts --project=chromium",
    "dev:demos": "pnpm -F @luently/demos dev",
    "dev:e2e": "pnpm -F @luently/e2e dev",
    "dev:ns-site": "pnpm -F @luently/noriscript-site docs:dev",
    "dev:luent-site": "pnpm -F @luently/luent-site docs:dev",
    "prep:luent:publish": "pnpm --dir packages/luent run prep:publish",
    "build:ns-site": "pnpm -F @luently/noriscript-site docs:build",
    "build:luent-site": "pnpm -F @luently/luent-site docs:build",
    "preview:ns-site": "pnpm -F @luently/noriscript-site docs:preview",
    "preview:luent-site": "pnpm -F @luently/luent-site docs:preview"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^8.3.4",
    "vite-plugin-babel": "^1.3.0",
    "vitest": "^4.1.2"
  },
  "author": "Ruby Yi Wang",
  "license": "MIT",
  "packageManager": "pnpm@11.10.0"
}
