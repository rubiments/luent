{
   "name": "luent",
   "private": false,
   "version": "0.0.1",
   "description": "An expressive framework for building web applications with clarity and flow",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/rubiments/luent.git",
      "directory": "packages/luent"
   },
   "homepage": "https://github.com/rubiments/luent",
   "type": "module",
   "exports": {
      ".": {
         "types": "./src/index.ts",
         "import": "./src/index.ts",
         "default": "./src/index.ts"
      },
      "./client": {
         "types": "./src/client/index.ts",
         "import": "./src/client/index.ts",
         "default": "./src/client/index.ts"
      },
      "./server": {
         "types": "./src/server/index.ts",
         "import": "./src/server/index.ts",
         "default": "./src/server/index.ts"
      },
      "./jsx-runtime": {
         "types": "./src/jsx-runtime/index.ts",
         "import": "./src/jsx-runtime/index.ts",
         "default": "./src/jsx-runtime/index.ts"
      },
      "./jsx-dev-runtime": {
         "types": "./src/jsx-runtime/index.ts",
         "import": "./src/jsx-runtime/index.ts",
         "default": "./src/jsx-runtime/index.ts"
      }
   },
   "types": "./src/index.ts",
   "main": "./src/index.ts",
   "module": "./src/index.ts",
   "files": [
      "dist",
      "jsx-runtime.d.ts"
   ],
   "scripts": {
      "build": "pnpm run build:js && pnpm run build:dts",
      "build:js": "tsdown",
      "build:dts": "pnpm run build:dts:deps && tsc -p tsconfig.build.json && node ./scripts/bundle-dts.mjs",
      "build:dts:deps": "pnpm --filter @luently/types run build:types && pnpm --filter @luently/utils run build:types && pnpm --filter @luently/flask run build:types && pnpm --filter @luently/quarky run build:types && pnpm --filter @luently/tree-squirl run build:types && pnpm --filter @luently/noriscript run build:types",
      "prepack": "pnpm run build",
      "prepublishOnly": "pnpm run build",
      "prep:publish": "npm pack --dry-run",
      "pack": "pnpm pack",
      "publish:dry": "pnpm publish --dry-run --no-git-checks",
      "publish:public": "pnpm publish --no-git-checks"
   },
   "devDependencies": {
      "@luently/flask": "workspace:*",
      "@luently/noriscript": "workspace:*",
      "@luently/quarky": "workspace:*",
      "@luently/types": "workspace:*",
      "@luently/utils": "workspace:*",
      "tsdown": "^0.21.9",
      "typescript": "^7.0.2",
      "csstype": "^3.1.0"
   },
   "publishConfig": {
      "access": "public",
      "main": "./dist/index.mjs",
      "module": "./dist/index.mjs",
      "types": "./dist/index.d.ts",
      "exports": {
         ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "default": "./dist/index.mjs"
         },
         "./client": {
            "types": "./dist/client/index.d.ts",
            "import": "./dist/client/index.mjs",
            "default": "./dist/client/index.mjs"
         },
         "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.mjs",
            "default": "./dist/server/index.mjs"
         },
         "./jsx-runtime": {
            "types": "./jsx-runtime.d.ts",
            "import": "./dist/jsx-runtime.mjs",
            "default": "./dist/jsx-runtime.mjs"
         },
         "./jsx-dev-runtime": {
            "types": "./jsx-runtime.d.ts",
            "import": "./dist/jsx-runtime.mjs",
            "default": "./dist/jsx-runtime.mjs"
         }
      }
   },
   "author": "Ruby Yi Wang",
   "license": "MIT"
}
