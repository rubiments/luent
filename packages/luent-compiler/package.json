{
  "name": "luent-compiler",
  "version": "0.0.0",
  "private": true,
  "description": "Luent JSX transforms",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsdown",
    "build:types": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@luently/utils": "workspace:*",
    "@luently/tree-squirl": "workspace:*",
    "oxc-parser": "^0.153.0",
    "@luently/scribe": "workspace:*"
  },
  "devDependencies": {
    "@luently/types": "workspace:*",
    "tsdown": "^0.21.9"
  },
  "author": "Ruby Yi Wang",
  "license": "MIT"
}