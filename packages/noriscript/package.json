{
  "name": "@luently/noriscript",
  "private": false,
  "version": "0.0.0",
  "description": "",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./transpile": {
      "types": "./src/transpile.ts",
      "import": "./src/transpile.ts",
      "default": "./src/transpile.ts"
    }
  },
  "types": "./src/index.ts",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "tsdown",
    "build:types": "tsc -p tsconfig.build.json",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run build",
    "pack": "pnpm pack",
    "publish:dry": "pnpm publish --dry-run --no-git-checks",
    "publish:public": "pnpm publish --no-git-checks"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/types/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      },
      "./transpile": {
        "types": "./dist/types/transpile.d.ts",
        "import": "./dist/transpile.mjs",
        "default": "./dist/transpile.mjs"
      }
    }
  },
  "dependencies": {
    "@jridgewell/gen-mapping": "^0.3.13",
    "@luently/tree-squirl": "workspace:*",
    "@luently/scribe": "workspace:*",
    "@luently/utils": "workspace:*",
    "@types/estree": "^1.0.8",
    "@types/estree-jsx": "^1.0.5",
    "@volar/language-core": "~2.4.0",
    "oxc-parser": "^0.153.0"
  },
  "devDependencies": {
    "@luently/types": "workspace:*",
    "tsdown": "^0.21.9",
    "typescript": "^7.0.2"
  },
  "author": "Ruby Yi Wang",
  "license": "MIT"
}