{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowArbitraryExtensions": true,
    "allowSyntheticDefaultImports": true,
    "lib": [
      "ESNext",
      "DOM"
    ],
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "noCheck": true,
    "types": [],
    "rootDir": "./src",
    "outDir": "./dist/types",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo/noriscript.dts.tsbuildinfo"
  },
  "include": [
    "../env.d.ts",
    "./src/**/*.ts"
  ],
  "exclude": [
    "./src/**/__tests__/**",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx"
  ],
  "references": [
    { "path": "../types/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" },
    { "path": "../tree-squirl/tsconfig.build.json" }
  ]
}
