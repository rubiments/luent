{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "jsx": "preserve",
    "paths": {
      "luent/jsx-runtime": [
        "../luent/src/jsx-runtime/index.ts"
      ],
      "luent/jsx-dev-runtime": [
        "../luent/src/jsx-runtime/index.ts"
      ]
    },
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "erasableSyntaxOnly": false,
    "noCheck": true,
    "types": [],
    "rootDir": "./src",
    "outDir": "./dist/types",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo/tree-squirl.dts.tsbuildinfo"
  },
  "include": [
    "../env.d.ts",
    "./src/**/*.ts"
  ],
  "exclude": [
    "./src/**/__tests__/**",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx"
  ],
  "references": [
    { "path": "../types/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" }
  ]
}
