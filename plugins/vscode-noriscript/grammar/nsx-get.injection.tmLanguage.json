{
  "scopeName": "nsx.get.injection",
  "injectionSelector": "L:source.tsx -comment -string, L:source.ts -comment -string, L:source.nsx -comment -string, L:source.ns -comment -string",
  "patterns": [
    {
      "name": "storage.modifier.mutability",
      "match": "\\bmu(?=\\s*\\()"
    },
    {
      "name": "keyword.control.flow",
      "match": "<::(?=\\s|>)"
    },
    {
      "name": "keyword.control.flow",
      "match": "<\\/::>"
    },
    {
      "match": "^(\\s*)(<:>)",
      "captures": {
        "2": {
          "name": "keyword.control.flow"
        }
      }
    },
    {
      "match": "^(\\s*)(</:>)",
      "captures": {
        "2": {
          "name": "keyword.control.flow"
        }
      }
    },
    {
      "name": "keyword.operator.at",
      "match": "(?<=[A-Za-z_$][\\w$]*)@"
    },
    {
      "name": "keyword.operator.at",
      "match": "(?<=\\))@(?=\\s*(?:\\(\\s*\\))?)"
    },
    {
      "name": "keyword.operator.at",
      "match": "(?<=\\})@(?=\\s*(?:\\(\\s*\\))?)"
    },
    {
      "name": "keyword.operator.at",
      "match": "(?<=\\])@(?=\\s*(?:\\(\\s*\\))?)"
    },
    {
      "name": "keyword.operator.at",
      "match": "(?<=[?!])@(?=\\s*(?:\\(\\s*\\))?)"
    },
    {
      "name": "storage.type",
      "match": "\\bget(?=\\s+[A-Za-z_$][\\w$]*\\s*=)"
    },
    {
      "name": "storage.type",
      "match": "\\bget(?=\\s+[A-Za-z_$][\\w$]*\\s*:)"
    },
    {
      "name": "storage.type",
      "match": "\\bget(?=\\s+[A-Za-z_$][\\w$]*\\s*\\()"
    }
  ]
}
