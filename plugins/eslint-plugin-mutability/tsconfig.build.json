{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "noCheck": true,
    "types": [],
    "rootDir": "./src",
    "outDir": "./dist/types",
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo/eslint-plugin-mutability.dts.tsbuildinfo"
  },
  "include": [
    "../env.d.ts",
    "./src/**/*.ts"
  ],
  "exclude": [
    "./src/**/__tests__/**",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx"
  ]
}
