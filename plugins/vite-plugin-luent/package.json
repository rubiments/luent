{
  "name": "vite-plugin-luent",
  "version": "0.0.1",
  "private": false,
  "description": "A Vite plugin for transpiling Luent TSX/JSX/NSX sources during development and builds.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepublishOnly": "pnpm run build",
    "prepack": "pnpm run build && node -e \"console.log('Preparing vite-plugin-luent for npm publish')\"",
    "pack": "pnpm pack",
    "publish:dry": "pnpm publish --dry-run --no-git-checks",
    "prep:publish": "npm pack --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rubiments/luent.git",
    "directory": "plugins/vite-plugin-luent"
  },
  "homepage": "https://github.com/rubiments/luent/tree/main/plugins/vite-plugin-luent#README",
  "bugs": {
    "url": "https://github.com/rubiments/luent/issues"
  },
  "keywords": [
    "vite",
    "plugin",
    "luent",
    "nsx",
    "jsx",
    "tsx"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@babel/core": "^8.0.7",
    "@babel/plugin-syntax-typescript": "^8.0.3",
    "@luently/babel-plugin-luent": "workspace:*",
    "fast-glob": "^3.3.3",
    "luent-compiler": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "author": "Ruby Yi Wang",
  "license": "MIT"
}