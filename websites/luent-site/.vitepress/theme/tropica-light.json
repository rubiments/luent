{
  "name": "tropica-light",
  "type": "light",
  "colors": {
    "editor.background": "#f8f8f8",
    "editor.foreground": "#1c1d22",
    "editorCursor.foreground": "#1e8a94",
    "editor.selectionBackground": "rgba(18,181,208,0.18)",
    "editorLineNumber.foreground": "#b1b4bd"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6c6f7d",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#387b85"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#147c86"
      }
    },
    {
      "scope": [
        "support.function",
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#147c86"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "support.variable"
      ],
      "settings": {
        "foreground": "#1c1d22"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#a4620a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#a4620a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#1b7a89"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#b95311"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#a3640f"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#387b85"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#6c707e"
      }
    }
  ]
}