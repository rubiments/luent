{
  "name": "tropica-dark",
  "type": "dark",
  "colors": {
    "editor.background": "#15161b",
    "editor.foreground": "#d8d9e0",
    "editorCursor.foreground": "#5cc5ce",
    "editor.selectionBackground": "rgba(18,181,208, 0.22)",
    "editorLineNumber.foreground": "#5e6273"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6c7080",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7fb0b8"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "support.type",
        "entity.name.class"
      ],
      "settings": {
        "foreground": "#5cc5ce"
      }
    },
    {
      "scope": [
        "support.function",
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#5cc5ce"
      }
    },
    {
      "scope": [
        "variable",
        "variable.parameter",
        "support.variable"
      ],
      "settings": {
        "foreground": "#d8d9e0"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#b9c78a"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#e6c77a"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7ed4e4"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d0a86e"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.character"
      ],
      "settings": {
        "foreground": "#f0b86c"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#7fb0b8"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#8d91a1"
      }
    }
  ]
}